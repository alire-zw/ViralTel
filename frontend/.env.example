# Backend API origin (no trailing slash required; code strips it).
# Used for all /api requests from the mini-app.
VITE_API_BASE_URL=https://proxtest.mirall.ir

# Temporary browser OTP login for e-namad / SMS template review.
# Must match backend BROWSER_PUBLIC_MODE=true. Turn OFF after approval.
VITE_BROWSER_PUBLIC_MODE=true
