# Application
NODE_ENV=development
HOST=0.0.0.0
PORT=4321

# Database (MySQL)
DB_HOST=localhost
DB_NAME=OneStar
DB_USER=root
DB_PASSWORD=
DB_PORT=3306

# Redis
REDIS_URL=redis://localhost:6379

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_BOT_SECRET=change-this-to-a-random-32-char-minimum-secret
# Optional Bot API root when api.telegram.org is blocked (default: https://api.telegram.org)
# TELEGRAM_API_ROOT=https://api.telegram.org
PUBLIC_URL=https://proxtest.mirall.ir
WEBHOOK_PATH=/bot/webhook

# Mini App
MINI_APP_URL=https://your-mini-app-url.example.com

# Security
CORS_ORIGINS=http://localhost:6543,https://proxtest2.mirall.ir
TRUST_PROXY=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Zibal Payment Gateway
ZIBAL_MERCHANT=zibal
ZIBAL_GATEWAY_URL=https://gateway.zibal.ir

# Zibal Facility / KYC inquiry APIs (Access Token from پنل → توسعه‌دهندگان → API Token)
ZIBAL_FACILITY_BASE_URL=https://api.zibal.ir
ZIBAL_FACILITY_ACCESS_TOKEN=

# TRON Crypto Payment (shasta = testnet, mainnet = production)
TRON_NETWORK=shasta
TRON_MASTER_ADDRESS=your-tron-master-wallet-address
TRONGRID_API_KEY=your-trongrid-api-key
TRON_CRON_INTERVAL_MS=15000
CRYPTO_PAYMENT_TTL_MINUTES=10

# SwapWallet Price API
SWAPWALLET_API_KEY=your-swapwallet-api-key
SWAPWALLET_API_URL=https://swapwallet.app/api
SWAPWALLET_APP_NAME=viraltel

# MarketApp Fragment API (Stars)
MARKETAPP_API_URL=https://api.marketapp.org
MARKETAPP_API_TOKEN=your-marketapp-api-token

# Callinoo Virtual Number API
CALLINOO_API_URL=https://api.ozvinoo.xyz
CALLINOO_API_TOKEN=your-callinoo-api-token

# Power-Tel SMM API (Reactions)
POWERTEL_API_URL=https://api.power-tel.ir/v2/
POWERTEL_API_KEY=your-powertel-api-key

# Canboso Buyer API (digital accounts)
CANBOSO_API_URL=https://canboso.com
CANBOSO_BUYER_API_KEY=your-canboso-buyer-api-key

# Roboticvn Customer API (account plan catalog assist + stock)
ROBOTICVN_API_URL=https://api.roboticvn.com
ROBOTICVN_API_KEY=your-roboticvn-api-key

# SMS.ir Verify OTP
SMSIR_API_URL=https://api.sms.ir/v1
SMSIR_API_KEY=your-smsir-api-key
SMSIR_VERIFY_TEMPLATE_ID=736133
SMSIR_VERIFY_PARAM_NAME=Code
SMSIR_ACCOUNT_ORDER_RECEIVED_TEMPLATE_ID=449030
# Must be a different sms.ir verify template for "order delivered" (not the same as received)
SMSIR_ACCOUNT_ORDER_DELIVERED_TEMPLATE_ID=449030
SMSIR_ACCOUNT_ORDER_PARAM_NAME=ORDER_ID

# Temporary browser access (e-namad / SMS template review only)
# Set both frontend VITE_BROWSER_PUBLIC_MODE=true and this to true, then turn OFF after approval.
BROWSER_PUBLIC_MODE=true
# Optional; defaults to TELEGRAM_BOT_TOKEN when omitted
# BROWSER_SESSION_SECRET=replace-with-long-random-secret
BROWSER_SESSION_TTL_SECONDS=604800

# Main admins (Telegram numeric IDs � exactly two)
MAIN_ADMIN_TELEGRAM_IDS=111111111,222222222
